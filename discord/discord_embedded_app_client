#ifndef DISCORD_EMBEDDED_APP_CLIENT_H
#define DISCORD_EMBEDDED_APP_CLIENT_H

#include "../thirdparty_client.h"
#include "platform/web/api/javascript_bridge_singleton.h"
#include "scene/main/node.h"

class DiscordEmbeddedAppClient : public ThirdPartyClient {
	GDCLASS(DiscordEmbeddedAppClient, ThirdPartyClient);

private:
	String frame_id;
	String instance_id;
	String platform;
	String channel_id;
	String client_id;
	String guild_id;
	String user_id;
	String custom_id;
	String referrer_id;

	Ref<JavaScriptBridge> js_bridge;
	Ref<JavaScriptBridge> source;
	String source_origin;

	bool is_ready = false;
	bool subscribed = false;

	TypedArray<String> events = "VOICE_STATE_UPDATE", "SPEAKING_START", "SPEAKING_STOP",
					   "ACTIVITY_LAYOUT_MODE_UPDATE", "ORIENTATION_UPDATE", "CURRENT_USER_UPDATE",
					   "THERMAL_STATE_UPDATE", "ACTIVITY_INSTANCE_PARTICIPANTS_UPDATE",
					   "ENTITLEMENT_CREATE", "CURRENT_GUILD_MEMBER_UPDATE"
public:
// Godot methods
static void _register_methods() {
	register_method("_ready", &DiscordEmbeddedAppClient::_ready);
	register_method("init", &DiscordEmbeddedAppClient::init);
	register_method("send_message", &DiscordEmbeddedAppClient::send_message);
	register_method("subscribe_to_events", &DiscordEmbeddedAppClient::subscribe_to_events);
	register_method("handshake", &DiscordEmbeddedAppClient::handshake);
	register_method("get_frame_id", &DiscordEmbeddedAppClient::get_frame_id);
	register_method("get_instance_id", &DiscordEmbeddedAppClient::get_instance_id);
	register_method("get_platform", &DiscordEmbeddedAppClient::get_platform);
	register_method("get_channel_id", &DiscordEmbeddedAppClient::get_channel_id);
	register_method("get_client_id", &DiscordEmbeddedAppClient::get_client_id);
	register_method("get_guild_id", &DiscordEmbeddedAppClient::get_guild_id);
	register_method("get_user_id", &DiscordEmbeddedAppClient::get_user_id);
	register_method("get_custom_id", &DiscordEmbeddedAppClient::get_custom_id);
	register_method("get_referrer_id", &DiscordEmbeddedAppClient::get_referrer_id);
	register_method("get_is_ready", &DiscordEmbeddedAppClient::get_is_ready);

	// Signals
	register_signal<DiscordEmbeddedAppClient>("packet_received", "opcode", GODOT_VARIANT_TYPE_INT, "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_ready", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_any", "event", GODOT_VARIANT_TYPE_STRING, "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_voice_state_update", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_speaking_start", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_speaking_stop", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_activity_layout_mode_update", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_orientation_update", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_current_user_update", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_thermal_state_update", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_activity_instance_participants_update", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_entitlement_create", "data", GODOT_VARIANT_TYPE_DICTIONARY);
	register_signal<DiscordEmbeddedAppClient>("dispatch_current_guild_member_update", "data", GODOT_VARIANT_TYPE_DICTIONARY);
}

// Initialization
void _init() {}

// Called when the node is ready
void _ready() {
	JavaScriptBridge *js_bridge = JavaScriptBridge::get_singleton();
	if (!js_bridge) {
		ERR_PRINT("Javascript bridge not available.");
		return;
	}
	js_bridge->get_interface("window")->call("addEventListener", "message", Variant::from_script(js_bridge->create_callback([this](Variant event) {
		_handle_message(event);
	})));
}

// Initialization method
void init(String client_id_) {
	if (!in_js) {
		Godot::print("Not in a JavaScript environment. Ignoring call to init().");
		return;
	}

	Dictionary query_map = _parse_query_string(OS::get_singleton()->get_cmdline_args());
	frame_id = query_map.get("frame_id", "");
	instance_id = query_map.get("instance_id", "");
	platform = query_map.get("platform", "");
	channel_id = query_map.get("channel_id", "");
	guild_id = query_map.get("guild_id", "");
	custom_id = query_map.get("custom_id", "");
	referrer_id = query_map.get("referrer_id", "");
	client_id = client_id_;

	source = js_bridge->get_interface("window")->get("parent.opener");
	if (source.is_null()) {
		source = js_bridge->get_interface("window")->get("parent");
	}
	source_origin = js_bridge->eval("!!document.referrer ? document.referrer : '*'");
	handshake();
}

// Sends a message to the Discord overlay
void send_message(int opcode, Dictionary body) {
	if (!in_js) {
		Godot::print("Not in a JavaScript environment. Ignoring call to send_message().");
		return;
	}

	Array data;
	data.push_back(opcode);
	data.push_back(body);

	String js_command = String("window.source.postMessage(") + JSON::get_singleton()->stringify(data) + ", '*')";
	js_bridge->eval(js_command, false);
}

// Subscribes to all predefined events
void subscribe_to_events() {
	if (subscribed)
		return;
	for (int i = 0; i < events.size(); i++) {
		String event = events[i];
		Dictionary args;
		args["cmd"] = "SUBSCRIBE";
		args["evt"] = event;
		args["args"] = Dictionary::make("channel_id", channel_id, "guild_id", guild_id);
		args["nonce"] = _generate_nonce();

		send_message(1, args);
	}
	subscribed = true;
}

// Performs handshake
void handshake() {
	Godot::print("Shaking hands...");
	Dictionary body;
	body["v"] = 1;
	body["encoding"] = "json";
	body["client_id"] = client_id;
	body["frame_id"] = frame_id;

	send_message(0, body);
}

// Getter methods
String get_frame_id() { return frame_id; }
String get_instance_id() { return instance_id; }
String get_platform() { return platform; }
String get_channel_id() { return channel_id; }
String get_client_id() { return client_id; }
String get_guild_id() { return guild_id; }
String get_user_id() { return user_id; }
String get_custom_id() { return custom_id; }
String get_referrer_id() { return referrer_id; }
bool get_is_ready() { return is_ready; }

private:
// Helper to parse query string
Dictionary _parse_query_string(Array args) {
	Dictionary query_map;
	for (int i = 0; i < args.size(); i++) {
		String part = args[i];
		Array parts = part.split("=");
		if (parts.size() == 2) {
			query_map[parts[0]] = parts[1];
		}
	}
	return query_map;
}

// Generates a nonce
String _generate_nonce() {
	String chars = "0123456789abcdef";
	String nonce;
	for (int i = 0; i < 32; i++) {
		nonce += chars[rand() % chars.length()];
	}
	return nonce;
}

// Handles incoming messages
void _handle_message(Variant event) {
	Variant data_variant = js_bridge->eval("JSON.stringify(event.data[1])");
	Dictionary data = JSON::get_singleton()->parse(data_variant)->get_result();

	if ((int)event["data"][0] == 1) { // Opcode.FRAME
		if (data.has("cmd") && data["cmd"] == "DISPATCH") {
			_handle_dispatch(data);
		} else {
			emit_signal("packet_received", event["data"][0], data);
		}
	} else {
		emit_signal("packet_received", event["data"][0], data);
	}
}

// Handles DISPATCH events
void _handle_dispatch(Dictionary data) {
	String event = data["evt"];
	emit_signal("dispatch_any", event, data["data"]);

	if (event == "READY") {
		is_ready = true;
		emit_signal("dispatch_ready", data["data"]);
	} else if (event == "VOICE_STATE_UPDATE") {
		emit_signal("dispatch_voice_state_update", data["data"]);
	} else if (event == "SPEAKING_START") {
		emit_signal("dispatch_speaking_start", data["data"]);
	} else if (event == "SPEAKING_STOP") {
		emit_signal("dispatch_speaking_stop", data["data"]);
	} else if (event == "ACTIVITY_LAYOUT_MODE_UPDATE") {
		emit_signal("dispatch_activity_layout_mode_update", data["data"]);
	} else if (event == "ORIENTATION_UPDATE") {
		emit_signal("dispatch_orientation_update", data["data"]);
	} else if (event == "CURRENT_USER_UPDATE") {
		emit_signal("dispatch_current_user_update", data["data"]);
	} else if (event == "THERMAL_STATE_UPDATE") {
		emit_signal("dispatch_thermal_state_update", data["data"]);
	} else if (event == "ACTIVITY_INSTANCE_PARTICIPANTS_UPDATE") {
		emit_signal("dispatch_activity_instance_participants_update", data["data"]);
	} else if (event == "ENTITLEMENT_CREATE") {
		emit_signal("dispatch_entitlement_create", data["data"]);
	} else if (event == "CURRENT_GUILD_MEMBER_UPDATE") {
		emit_signal("dispatch_current_guild_member_update", data["data"]);
	}
}
}
;

#endif // DISCORD_EMBEDDED_APP_CLIENT_H
